# NIRIKSHAK Enforcement Workstation - Environment Variables

# Backend API base URL (defaults to /api/v1 which is proxied by vercel.json rewrites)
VITE_API_BASE_URL=/api/v1

# Demo Officer auto-authentication password for live backend access
# Matches seeded password in backend/evidence/database.py ('Officer@2026')
VITE_DEMO_OFFICER_PASSWORD=Officer@2026
